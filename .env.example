# 이 파일을 복사해서 이름을 .env 로 바꾸고 키를 채우세요.

# (선택) Claude API 키 — 있으면 로컬 로직 대신 AI가 골라줍니다.
# console.anthropic.com 에서 발급. 없어도 로컬 추천으로 동작.
ANTHROPIC_API_KEY=

# (v0.2 필수) Steam Web API 키 — 게임/도전과제를 읽으려면 필요.
# https://steamcommunity.com/dev/apikey 에서 발급 (무료).
# ※ OpenID 로그인과 별개로 이 키가 있어야 데이터 조회가 됩니다.
STEAM_API_KEY=

# 회사망 SSL 검사(self-signed certificate) 오류가 나면 1 로 설정 (개발용 우회).
# 집/일반 네트워크면 비워두세요. 배포 빌드에선 쓰지 말 것.
INSECURE_TLS=

# (배포 필수) gd_auth 로그인 쿠키를 HMAC 서명하는 키. 임의의 긴 문자열.
# ※ 이 값이 없거나 기본값이면 배포 환경에서는 서버가 아예 뜨지 않습니다.
#    없이 띄우면 누구나 남의 SteamID 로 서명된 쿠키를 만들어 그 사람 행세를 할 수 있습니다.
SESSION_SECRET=

# (배포) 서비스의 실제 주소. Steam OpenID 의 realm/return_to 로 그대로 쓰이므로
# 접속 주소와 정확히 같아야 합니다. Render 는 RENDER_EXTERNAL_URL 을 자동으로
# 넣어주므로 커스텀 도메인을 붙일 때만 채우면 됩니다. 예: https://내서비스.com
BASE_URL=

# (선택) 캐시·상태 파일을 쓸 위치. 비우면 web/ 아래.
# Render 영구 디스크를 붙였다면 마운트 경로(예: /var/data)를 넣습니다.
DATA_DIR=

# (배포 권장) 원격 영속 저장소 — Supabase Storage.
# Render 무료 플랜은 디스크가 휘발성이라, 이게 없으면 재배포마다 뽑기 기록이 사라집니다.
# (캐시는 40초 재동기화로 복구되지만 기록은 복구 방법이 없습니다.)
#
# 준비: Supabase 프로젝트 생성 → Storage 에 'gd-data' 버킷을 Private 으로 만들기
#   URL   : Project Settings → API → Project URL
#   KEY   : Project Settings → API → service_role (secret)
# ※ service_role 은 RLS 를 우회하는 관리자 키입니다. 서버에만 두세요.
#   비워두면 원격 백업이 그냥 꺼지고 로컬 파일로만 동작합니다.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# (개발용) 여기에 SteamID를 넣으면 /dev/login 으로 Steam 로그인 없이 바로 그 계정
# 상태가 됩니다. 디자인 도구·다른 브라우저에서 인증된 화면을 볼 때 씁니다.
# localhost/127.0.0.1 요청에만 응답하고, 이 값이 비어 있으면 404 입니다.
# ※ 배포 환경에는 절대 넣지 마세요.
DEV_LOGIN_STEAMID=
